#include <iostream>
#include <vector>
using namespace std;

bool clearBlock(vector<vector<int>> &a, int R, int C) {
    bool clear = true;
    
    for (int i = R - 1; i >= 0; i--) {
        bool clearLine = false;
        for (int j = 0; j < C; j++) {
            if (a[i][j] != 1) {
                clearLine = true;
                break;
            }
        }
        
        if (!clearLine) {
            for (int k = 0; k < C; k++) {
                a[i][k] = 0;
            }
            clear = false;
        }
    }
    
    return clear;
}

bool fallBlock(vector<vector<int>> &a, int R, int C) {
    bool clear = true;
    
    for (int j = 0; j < C; j++) {
        for (int i = R - 2; i >= 0; i--) {
            while (i + 1 < R && a[i][j] == 1 && a[i + 1][j] == 0) {
                a[i][j] = 0;
                a[i + 1][j] = 1;
                i++;
                clear = false;
            }
        }
    }
    
    return clear;
}

